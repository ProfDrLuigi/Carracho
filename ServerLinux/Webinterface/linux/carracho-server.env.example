# /opt/carracho/etc/carracho-server.env
#
# Empfohlene Rechte:
#   chown root:root /opt/carracho/etc/carracho-server.env
#   chmod 0600 /opt/carracho/etc/carracho-server.env
#
# Der Server liest diese Datei über den systemd-Drop-in. Der WebAdmin-Child
# erbt den Token anschließend vom carracho-server-Prozess.

CARRACHO_HTTP_ADMIN_TOKEN=HIER_EINEN_MINDESTENS_24_ZEICHEN_TOKEN_SETZEN

# Optional:
# CARRACHO_WEB_ADMIN_BIND=127.0.0.1
# CARRACHO_WEB_ADMIN_PORT=6781
# CARRACHO_HTTP_ADMIN_URL=http://127.0.0.1:6780/api/v1
# CARRACHO_WEB_ADMIN_HELPER=/opt/carracho/libexec/carracho/carracho-web-admin-helper
